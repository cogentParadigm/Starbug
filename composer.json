{
  "name": "starbug/starbug",
  "type": "project",
  "description": "Starbug Framework",
  "extra": {
    "modules-plugin": {
      "types": {
        "starbug-library": "module",
        "starbug-module": "module",
        "starbug-theme": "theme",
        "starbug-custom-module": "module",
        "starbug-custom-theme": "theme"
      },
      "parameters": [
        "namespace"
      ],
      "key": "starbug"
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "./app/themes/*"
    }
  ],
  "require": {
    "starbug/di": "^1.0",
    "starbug/modules": "^1.0",
    "starbug/bundle": "^1.0",
    "starbug/resource-locator": "^0.9",
    "starbug/http": "^0.9.17",
    "starbug/auth": "^1.0",
    "starbug/operation": "^0.8",
    "starbug/macro": "^0.9",
    "starbug/config": "^0.9.0",
    "masterexploder/phpthumb": "dev-master",
    "ezyang/htmlpurifier": "^4.13",
    "wp-cli/php-cli-tools": "^0.10.5",
    "starbug/db": "^0.12",
    "starbug/doctrine": "^0.9",
    "starbug/users": "^0.9.1",
    "starbug/users-admin": "^0.9.1",
    "starbug/files": "^0.9.2",
    "starbug/files-admin": "^0.9.1",
    "starbug/emails": "^0.10",
    "starbug/emails-admin": "^0.9",
    "starbug/css": "^0.9",
    "starbug/content": "^0.9.2",
    "starbug/content-admin": "^0.9.2",
    "starbug/storm": "^1.0.1",
    "starbug/redis": "^0.9",
    "starbug/log": "^0.10",
    "starbug/log-admin": "^0.9",
    "starbug/imports": "^0.9.1",
    "starbug/menus": "^0.9.1",
    "starbug/menus-admin": "^0.9",
    "starbug/queues": "^0.9",
    "starbug/settings": "^0.9",
    "starbug/settings-admin": "^0.9",
    "starbug/tachyons": "^1.1.3",
    "starbug/routing": "^1.1.1",
    "starbug/templates": "^1.1.0",
    "starbug/admin": "^0.9",
    "starbug/webpack": "^1.0.0",
    "starbug/dojo": "^1.1.0",
    "starbug/display": "^0.9.9",
    "starbug/api": "^0.9.3"
  },
  "require-dev": {
    "starbug/devel": "^1.5",
    "starbug/testing": "^1.1.1",
    "php-forge/foxy": "*"
  },
  "autoload": {
    "psr-4": {
      "Starbug\\App\\": "app/src/"
    },
    "classmap": [
      "core",
      "var",
      "features"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Starbug\\Users\\Tests\\": "modules/users/tests/",
      "Starbug\\Content\\Tests\\": "modules/content/tests/",
      "Starbug\\Users\\Admin\\Tests\\": "modules/users-admin/tests/",
      "Starbug\\Content\\Admin\\Tests\\": "modules/content-admin/tests/"
    }
  },
  "scripts": {
    "pre-install-cmd": "mkdir -p var/tmp var/log var/public/uploads var/private/uploads",
    "migrate": [
      "@php sb migrate",
      "@composer dump-autoload"
    ],
    "phploc": "vendor/bin/phploc --count-tests app core modules",
    "phpcs": "vendor/bin/phpcs --extensions=php --standard=vendor/starbug/standard/phpcs.xml --ignore=views,templates,layouts core app modules || true",
    "phpcbf": "vendor/bin/phpcbf --extensions=php --standard=vendor/starbug/standard/phpcs.xml --ignore=views,templates,layouts core app modules || true",
    "phpmd": "vendor/bin/phpmd . text vendor/starbug/standard/phpmd.xml --exclude libraries,var,node_modules,vendor || true",
    "phpcpd": "vendor/bin/phpcpd app core modules || true",
    "phpunit": "vendor/bin/phpunit -c etc/phpunit.xml || true",
    "behat": "vendor/bin/behat",
    "console": "php -d auto_prepend_file=vendor/starbug/di/bootstrap/default.php -a"
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "starbug/composer-modules-plugin": true,
      "php-http/discovery": true,
      "php-forge/foxy": true
    }
  }
}
