{
  "name": "starbug/db",
  "type": "starbug-module",
  "description": "Starbug database module.",
  "license": "GPL-3.0-or-later",
  "authors": [
    {
      "name": "Ali Gangji",
      "homepage": "https://github.com/cogentParadigm"
    }
  ],
  "extra": {
    "namespace": "Starbug\\Db"
  },
  "require": {
    "php": ">=8.0",
    "psr/log": "^1.0 || ^2.0 || ^3.0",
    "psr/simple-cache": "^1.0 || ^2.0 || ^3.0",
    "starbug/bundle": "^1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.0",
    "starbug/auth": "^1.0",
    "starbug/devel": "^1.5",
    "starbug/importer": "^0.10",
    "starbug/testing": "^1.1"
  },
  "suggest": {
    "ext-yaml": "YAML fixture loading via Importer\\Read\\YamlFixtureStrategy.",
    "starbug/auth": "Session-aware password, ownership, and action hooks.",
    "starbug/files": "File upload handling via StoreUploadHook.",
    "starbug/importer": "Import write strategies via Importer\\Write\\DatabaseStrategy and YAML fixtures in the testing trait.",
    "starbug/macro": "Token replacement in column patterns via StoreSlugHook.",
    "starbug/operation": "Operation-backed columns via StoreOperationHook.",
    "starbug/resource-locator": "Collection resolution via ResourceLocatorInterface.",
    "starbug/testing": "DatabaseTestCase and WebDatabaseTestCase bases.",
    "starbug/users": "Password strength validation via StorePasswordHook (provides zxcvbn-php)."
  },
  "autoload": {
    "psr-4": {
      "Starbug\\Db\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Starbug\\Db\\Tests\\": "tests/"
    }
  }
}
