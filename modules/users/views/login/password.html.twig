{% if helper("request").hasParameter("to") %}
  {% do helper("request").setParameter("to", helper("url").build(helper("request").getParameter("to"))) %}
{% endif %}
<div class="measure-wide">
  <h2>Login</h2>
  <p>Enter your email address and password below.</p>
  {{ helper("displays").render("Starbug\\Users\\Display\\LoginPasswordForm", {"url":helper("request").getParameter("to")}) }}
  <div class="f8 mt3">
    {% set queryParams = helper("request").getQueryParams() %}
    {% set queryString = queryParams|url_encode %}
    {% if queryString != "" %}
      {% set queryString = "?" ~ queryString %}
    {% endif %}
    <p><a href="{{ helper('url').build('login/link' ~ queryString) }}" class="underline">Send me an email link instead</a></p>
  </div>
</div>